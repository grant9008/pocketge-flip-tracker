# Gradle's own working directory. These are machine-local build caches and
# lock files; committing them breaks `git pull` for everyone else, because
# git refuses to overwrite the untracked copies their own builds created.
.gradle/
build/

# IntelliJ (the project is developed in IDEA)
.idea/
*.iml
out/

# Compiled output
*.class
*.jar
# ...except the Gradle wrapper, if one is ever added — that one IS meant to
# be committed, and a blanket *.jar would swallow it silently.
!gradle/wrapper/gradle-wrapper.jar

# Build logs redirected to a file from a local gradle run. One of these was
# committed by accident: 7KB of UTF-16 Windows daemon chatter in the repo
# root, which the plugin hub would have cloned along with the source.
deps.txt
*.log
